#!/bin/bash

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top height=36 \
                 color=$BAR_COLOR \
                 border_width=0 \
                 corner_radius=0 \
                 margin=0 \
                 blur_radius=0 \
                 padding_left=16 \
                 padding_right=16 \
                 shadow=off \
                 sticky=on \
                 topmost=window \
                 display=main

##### Changing Defaults #####
default=(
  updates=when_shown
  icon.font="Hack Nerd Font Mono:Bold:15.0"
  icon.color=$ICON_COLOR
  label.font="Hack Nerd Font Mono:Regular:13.0"
  label.color=$LABEL_COLOR
  popup.background.border_width=2
  popup.background.corner_radius=6
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
)

sketchybar --default "${default[@]}"

##### Clock — the one and only item #####
sketchybar --add item clock center \
           --set clock icon="󰅐" \
                       icon.font="SF Pro:Semibold:14.0" \
                       icon.color=0xddffffff \
                       icon.padding_left=14 \
                       icon.padding_right=6 \
                       label.font="SF Pro:Medium:12.0" \
                       label.color=0xddffffff \
                       label.padding_left=0 \
                       label.padding_right=14 \
                       update_freq=10 \
                       script="$PLUGIN_DIR/clock.sh" \
                       background.drawing=on \
                       background.color=$PILL_COLOR \
                       background.border_color=$PILL_BORDER_COLOR \
                       background.border_width=1 \
                       background.corner_radius=14 \
                       background.height=28 \
                       click_script="$PLUGIN_DIR/clock_click.sh"

##### Finalize Setup #####
sketchybar --update
